# Optional repo config (copy to .github/robin.yml)
# Read from the PR base branch. Nonblank inputs override config for defer-to-config
# settings. max-diff-size/max-comments use config when inputs equal 50000/15.
# The 25000/10 values below are sample overrides, not defaults.

max-diff-size: 25000
max-comments: 10
json-response-mode: true
# request-changes: true   # default; set false for advisor mode (never block the PR, even on high findings)
# bot-review-policy: all   # default; none skips GitHub Bot authors; allowlist permits listed bots plus humans
# bot-allowlist: []   # default empty list; with allowlist policy, excludes all bots
# Example allowlist (uncomment with bot-review-policy: allowlist):
# bot-allowlist:
#   - "dependabot[bot]"
#   - "renovate[bot]"
# Blank bot inputs defer here; workflow bot-allowlist: '[]' clears this list.
# Authorized manual /review bypasses the author filter; command permissions still apply.
# reasoning-effort: high   # unset: no reasoning control is sent, the provider/model decides. Set a value (low, medium, high, …) to send it, or "off" to be explicit
# agent-mode: off   # unset: auto (repository tools). Set off for diff-only reviews; recommended starting point for weak/local models
# An explicit agent-mode input overrides this base-branch setting; see docs/ADVANCED.md#default-change-and-migration
# agent-max-turns: 40   # default; tool-calling turns before the final review is requested
# agent-max-diff-size: 200000   # default; diff characters sent up front in agent mode (max-diff-size above applies to the single-shot fallback)

skip-paths:
  - "**/generated/**"
  - "**/*.snap"
